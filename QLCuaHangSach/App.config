<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="QLCuaHangSach"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=QLCuaHangSach;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Ngưỡng cảnh báo sách sắp hết hàng -->
    <add key="NguongTonKho" value="10" />
    <!-- Số tiền (VNĐ) để được 1 điểm tích lũy -->
    <add key="TienMoiDiem" value="10000" />
  </appSettings>
</configuration>
